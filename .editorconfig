# ==========================================
# Gustaveo - EditorConfig configuration
# ==========================================

root = true

# Default configuration
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

# JSON and YAML files
[*.{json,yml,yaml}]
indent_size = 2

# Markdown documentation
[*.md]
trim_trailing_whitespace = false

# Windows scripts
[*.{bat,cmd}]
end_of_line = crlf